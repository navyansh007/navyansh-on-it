# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored; this file is the committed
# reference for which keys exist.
# On Vercel, set these same keys under Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Sanity -----------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Editor-permission token. Create at sanity.io/manage -> API -> Tokens.
# Publishing from /write is disabled without it.
SANITY_WRITE_TOKEN=

# --- Composer & private journal ---------------------------------------------
# Unlocks /write and the private journal. Changing this immediately
# invalidates every remember-me token already issued.
ADMIN_PASSWORD=
