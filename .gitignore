# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

/navyansh-on-it

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
